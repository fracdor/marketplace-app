# Expo SDK 57 ships a peer-version conflict (react 19.2.3 vs 19.2.7 via
# expo-router -> @expo/ui -> vaul -> @radix-ui). This flag downgrades peer
# conflicts to warnings so installs succeed. It is a scoped workaround, not a
# blanket default: re-audit and narrow/remove once the SDK 57 peer graph
# stabilizes. When adding deps in later tasks, spot-check `npm ls` for peers
# this may be silently suppressing.
legacy-peer-deps=true
